name = "steamrelink"
main = "worker.js"
# serve only on the custom domain: the edge cache /stats relies on doesn't
# work on workers.dev, so a public workers.dev URL would bypass it
workers_dev = false
preview_urls = false
compatibility_date = "2026-09-01"

[[kv_namespaces]]
binding = "WORKSHOP_CACHE"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

[[ratelimits]]
name = "LOOKUP_LIMITER"
# any integer, unique within your Cloudflare account
namespace_id = "1001"

  # uncached lookups per IP; period must be 10 or 60 (seconds)
  [ratelimits.simple]
  limit = 20
  period = 60

[assets]
directory = "./public"
binding = "ASSETS"
